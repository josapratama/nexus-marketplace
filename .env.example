# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/nexus

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_ID=app

# ─────────────────────────────────────────
# Auth / Session
# Generate a random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# ─────────────────────────────────────────
# First user with this email becomes admin automatically
# ─────────────────────────────────────────
OWNER_EMAIL=

# ─────────────────────────────────────────
# Optional: OpenAI-compatible LLM (leave blank if not needed)
# ─────────────────────────────────────────
LLM_API_URL=
LLM_API_KEY=

# ─────────────────────────────────────────
# Optional: S3-compatible storage (leave blank if not needed)
# ─────────────────────────────────────────
STORAGE_API_URL=
STORAGE_API_KEY=

# ─────────────────────────────────────────
# Optional: Google Maps
# ─────────────────────────────────────────
VITE_MAPS_API_KEY=
VITE_MAPS_PROXY_URL=
